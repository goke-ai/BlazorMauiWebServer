@page "/weather"
@using System.Security.Claims
@using Goke.Core.Models
@using GokeSharedCore.WeatherApp
@using GokeWebServer.Services

@rendermode InteractiveServer
@attribute [StreamRendering]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWeatherForecastService WeatherForecastService

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates showing data.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <AuthorizeView Policy="WeatherMapEditPolicy">
        <Authorized>
            <WeatherForecastMapList Forecasts="forecasts" CanEdit="true" />
        </Authorized>
        <NotAuthorized>
            <WeatherForecastMapList Forecasts="forecasts" />
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    private WeatherForecast[]? forecasts;
    protected override async Task OnInitializedAsync()
    {
        await GetClaimsPrincipalData();

        var forecast = await WeatherForecastService.GetWeatherForecastsForDateTime(DateTime.UtcNow);
        forecasts = forecast != null ? forecast.ToArray() : Array.Empty<WeatherForecast>();
    }

    string? weatherMapEditClaimValue;
    private IEnumerable<Claim> claims = Enumerable.Empty<Claim>();

    private async Task GetClaimsPrincipalData()
    {
        var authState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            // authMessage = $"{user.Identity.Name} is authenticated.";
            claims = user.Claims;
            weatherMapEditClaimValue = claims.FirstOrDefault(c => c.Type == "Permission" && c.Value == "WeatherMap.Edit")?.Value;
        }
        else
        {
            // authMessage = "The user is NOT authenticated.";
        }
    }
}