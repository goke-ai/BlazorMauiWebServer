@page "/admin/user-roles/users/{UserId}/claims"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Identity
@using GokeWebServer.Data
@using GokeWebServer.Services

@attribute [Authorize(Roles = "Administrators")]
@rendermode InteractiveServer

@inject UserManager<ApplicationUser> UserManager
@inject AdminActivityLog ActivityLog

<PageTitle>User Claims</PageTitle>

<h1>User Claims</h1>

<div class="mb-4 d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary" href="/admin/user-roles/users/@UserId">Back to user</a>
    <a class="btn btn-outline-secondary" href="/admin/user-roles/users">Back to users</a>
    <a class="btn btn-outline-secondary" href="/admin/user-roles">Back to overview</a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (user is null)
{
    <div class="alert alert-warning" role="alert">User not found.</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">User</h2>
            <dl class="row mb-0">
                <dt class="col-sm-3">User name</dt>
                <dd class="col-sm-9">@DisplayName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@DisplayEmail</dd>

                <dt class="col-sm-3">Claims</dt>
                <dd class="col-sm-9">@claimEntries.Count</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Add claim</h2>

            <EditForm Model="claimInput" OnValidSubmit="AddClaimAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="claim-type">Claim type</label>
                        <InputText id="claim-type" @bind-Value="claimInput.ClaimType" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="claim-value">Claim value</label>
                        <InputText id="claim-value" @bind-Value="claimInput.ClaimValue" class="form-control" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-3" disabled="@isBusy">Add claim</button>
            </EditForm>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h2 class="h5">Current claims</h2>

            @if (claimEntries.Count == 0)
            {
                <p class="mb-0 text-secondary">This user has no claims.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Type</th>
                                <th scope="col">Value</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claimEntry in claimEntries)
                            {
                                <tr>
                                    <td>@claimEntry.Type</td>
                                    <td>@claimEntry.Value</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveClaimAsync(claimEntry)" disabled="@isBusy">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private ApplicationUser? user;
    private List<ClaimEntry> claimEntries = [];
    private ClaimInputModel claimInput = new();
    private bool isBusy;
    private string? statusMessage;
    private string? errorMessage;

    private string DisplayName => user?.UserName ?? "(no username)";
    private string DisplayEmail => user?.Email ?? "(no email)";

    protected override async Task OnParametersSetAsync()
    {
        statusMessage = null;
        errorMessage = null;
        await LoadClaimsAsync();
    }

    private async Task LoadClaimsAsync()
    {
        user = await UserManager.FindByIdAsync(UserId);
        claimEntries = [];

        if (user is null)
        {
            return;
        }

        claimEntries = (await UserManager.GetClaimsAsync(user))
            .OrderBy(claim => claim.Type)
            .ThenBy(claim => claim.Value)
            .Select(claim => new ClaimEntry
            {
                Type = claim.Type,
                Value = claim.Value
            })
            .ToList();
    }

    private async Task AddClaimAsync()
    {
        statusMessage = null;
        errorMessage = null;

        if (user is null)
        {
            errorMessage = "User not found.";
            return;
        }

        var claimType = claimInput.ClaimType?.Trim();
        var claimValue = claimInput.ClaimValue?.Trim();

        if (string.IsNullOrWhiteSpace(claimType) || string.IsNullOrWhiteSpace(claimValue))
        {
            errorMessage = "Enter both a claim type and a claim value.";
            return;
        }

        var existingClaims = await UserManager.GetClaimsAsync(user);
        if (existingClaims.Any(claim =>
            string.Equals(claim.Type, claimType, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(claim.Value, claimValue, StringComparison.Ordinal)))
        {
            errorMessage = "That claim is already assigned to the user.";
            return;
        }

        isBusy = true;

        try
        {
            var result = await UserManager.AddClaimAsync(user, new Claim(claimType, claimValue));
            if (!result.Succeeded)
            {
                errorMessage = IdentityErrorFormatter.Format(result);
                return;
            }

            claimInput = new ClaimInputModel();
            await LoadClaimsAsync();

            var message = $"Added claim '{claimType}={claimValue}' to {DisplayName}.";
            statusMessage = message;
            ActivityLog.Add("User claim added", message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RemoveClaimAsync(ClaimEntry claimEntry)
    {
        statusMessage = null;
        errorMessage = null;

        if (user is null)
        {
            errorMessage = "User not found.";
            return;
        }

        isBusy = true;

        try
        {
            var result = await UserManager.RemoveClaimAsync(user, new Claim(claimEntry.Type, claimEntry.Value));
            if (!result.Succeeded)
            {
                errorMessage = IdentityErrorFormatter.Format(result);
                return;
            }

            await LoadClaimsAsync();

            var message = $"Removed claim '{claimEntry.Type}={claimEntry.Value}' from {DisplayName}.";
            statusMessage = message;
            ActivityLog.Add("User claim removed", message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class ClaimEntry
    {
        public required string Type { get; init; }

        public required string Value { get; init; }
    }

    private sealed class ClaimInputModel
    {
        [Required]
        public string? ClaimType { get; set; }

        [Required]
        public string? ClaimValue { get; set; }
    }
}