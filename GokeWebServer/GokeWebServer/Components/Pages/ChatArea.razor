@using Goke.Core.Chat


<div>

    <ul class="nav nav-tabs" role="tablist">
        @foreach (var user in Users)
        {
            <li class="nav-item">
                <button type="button"
                        class="nav-link @(user.UserId == _selectedUser?.UserId ? "active" : null)"
                        @onclick="() => SelectUser(user)">
                    @user.FullName
                </button>
            </li>
        }
    </ul>

    @if (_selectedUser is not null)
    {
        <div class="tab-content">
            <div class="tab-pane fade show active">
                <h4>Chat with @_selectedUser.FullName</h4>
                <ul id="messagesList">
                    @foreach (var message in Messages
                                                .Where(w => w.SenderId == _selectedUser.UserId 
                                                || w.ReceiverId == _selectedUser.UserId))
                    {
                        <li class="@(message.SenderId == _selectedUser.UserId ? "text-secondary" : "text-primary text-end")">@message.Content</li>
                    }
                </ul>
            </div>
        </div>
    }

</div>

<div class="form-group">
    <label>
        Message:
        <input @bind="messageInput" size="50" />

    </label>
</div>
<button @onclick="SendHandler"        
        disabled="@(!IsConnected)"
        autofocus>
    Send
</button>


@code {
    [Parameter]
    public List<User> Users { get; set; } = new List<User>();  
    [Parameter]
    public List<MessageDto> Messages { get; set; } = new List<MessageDto>();
    [Parameter]
    public bool IsConnected { get; set; } = false;
    [Parameter]
    public EventCallback<SendMessageRequest> OnSendMessage { get; set; }

    private string? messageInput;

    string? senderName;
    private User? _selectedUser;

    private void SelectUser(User user)
    {
        _selectedUser = user;
    }

    private void SendHandler()
    {
        if (_selectedUser is not null && !string.IsNullOrWhiteSpace(messageInput))
        {
            var message = new SendMessageRequest
            {
                ReceiverId = _selectedUser.UserId,
                Content = messageInput,
                MessageType = MessageType.Text
            };
            OnSendMessage.InvokeAsync(message);
            messageInput = string.Empty;
        }
        
    }
}