@page "/weather-city"
@using System.Security.Claims
@using Goke.Core.Models
@using Goke.Core.Services

@rendermode InteractiveServer

@inject IHttpClientFactory httpClientFactory

<PageTitle>Weather</PageTitle>

<h1>@City Weather</h1>

<p>This component demonstrates showing data.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <WeatherForecastCardList Forecasts="forecasts" />
}

@code {
    [SupplyParameterFromQuery]
    private string? City { get; set; }

    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {        
        HttpClient httpClient = httpClientFactory.CreateClient(BackendApiEndpoints.ClientName);

        // Seed weather data here
        var DATA = await httpClient.GetFromJsonAsync<List<WeatherForecast>>($"api/weather/cities/{City}") ?? new List<WeatherForecast>();
        forecasts = DATA != null ? DATA.ToArray() : Array.Empty<WeatherForecast>();
    }
}
