@page "/location"
@using System.Linq
@using Goke.Core.Models
@using Goke.Core.Map
@using Goke.Core.Services
@using GokeShared.Services

@* @attribute [StreamRendering] *@
@rendermode InteractiveServer

@inject BrowserLocationService LocationService


<PageTitle>Location</PageTitle>

<h1>Location</h1>

<p>This component demonstrates showing data.</p>

@if (Markers == null || Markers.Count == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <button class="btn btn-primary" @onclick="Add">Add</button>
    <CurrentLocationMap Markers="Markers" />
}

@code {
    List<Goke.Core.Map.Location> _locations = [];
    public List<Goke.Core.Map.Location> Locations
    {
        get => _locations;
        private set
        {
            if (_locations != value)
            {
                _locations = value;
            }
        }
    }

    List<Goke.Core.Map.Location> DATA = [];

    DateTime current = DateTime.UtcNow;

    public bool HasNoLocations => Locations.Count == 0;

    public List<MapMarker> Markers => Locations.Select(location => new MapMarker
    {
        Latitude = location.Latitude,
        Longitude = location.Longitude,
        Name = location.Name,
        Description = $"Lat: {location.Latitude}, Lon: {location.Longitude}",
        MarkerShape = "Circle",
        MarkerColor = MapMarker.GetColor(location.Name),
    }).ToList();
    

    private CancellationTokenSource _cancelTokenSource;
    private bool _isCheckingLocation;

    protected override async Task OnInitializedAsync()
    {
        
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var loc = await GetCurrentLocationAsync();
        // Seed location data here
        DATA = new List<Goke.Core.Map.Location>
        {
            new Goke.Core.Map.Location { Latitude = 6.530601541004869, Longitude = 3.2792890540792294, Name = "Femi Osobu" },
            new Goke.Core.Map.Location { Latitude = 1.5630831374667737, Longitude = 103.6168111428407, Name = "Pulai Perdana" },
            new Goke.Core.Map.Location { Latitude = 1.5671234137643146, Longitude = 103.61329262550467, Name = "Enau" },
            new Goke.Core.Map.Location { Latitude = 1.555975049606735, Longitude = 103.56783852970288, Name = "Pulasan" },
            new Goke.Core.Map.Location { Latitude = 11.813208059803452, Longitude = 13.205843552095427, Name = "UNIMAID" },
            new Goke.Core.Map.Location { Latitude = 51.74989074677224, Longitude = 0.504468455212419, Name = "Foxglove" },
            // current device location can be added here if needed
            new Goke.Core.Map.Location { Latitude = loc?.Latitude ?? 0, Longitude = loc?.Longitude ?? 0, Name = "Current Location" },
            new Goke.Core.Map.Location { Latitude = 40.712776, Longitude = -74.005974, Name = "New York" },
            new Goke.Core.Map.Location { Latitude = 34.052235, Longitude = -118.243683, Name = "Los Angeles" },
            new Goke.Core.Map.Location { Latitude = 41.878113, Longitude = -87.629799, Name = "Chicago" },
            new Goke.Core.Map.Location { Latitude = 29.760427, Longitude = -95.369804, Name = "Houston" },
            new Goke.Core.Map.Location { Latitude = 33.448376, Longitude = -112.074036, Name = "Phoenix" },
            new Goke.Core.Map.Location { Latitude = 39.739236, Longitude = -104.990251, Name = "Denver" },
        };

        await OnLoadDataAsync();
    }

    protected async Task OnLoadDataAsync()
    {
        current = DateTime.UtcNow;

        // Simulate asynchronous loading to demonstrate a loading indicator
        await Task.Delay(500);

        //Locations = [.. DATA.Where(f => DateTime.Now.AddDays(-1) < f.Date && f.Date <= DateTime.Now.AddDays(1))];
        Locations = [.. DATA.Skip(Random.Shared.Next(DATA.Count)).Take(1)];

        StateHasChanged();
    }

    private void Add()
    {
        var availables = DATA.Where(f => Locations.Any(l => l.Name == f.Name) == false).ToArray();

        if (availables.Length != 0)
        {
            Locations = [.. Locations, availables[Random.Shared.Next(availables.Length)]];
        }

        StateHasChanged();
    }

    private async Task<Goke.Core.Map.Location?> GetCurrentLocationAsync()
    {
        try
        {
            _isCheckingLocation = true;
            _cancelTokenSource = new CancellationTokenSource();
            return await LocationService.GetCurrentLocationAsync();
        }
        catch
        {
            return null;
        }
        finally
        {
            _isCheckingLocation = false;
        }
    }

    public void CancelRequest()
    {
        if (_isCheckingLocation && _cancelTokenSource != null && _cancelTokenSource.IsCancellationRequested == false)
            _cancelTokenSource.Cancel();
    }

}
