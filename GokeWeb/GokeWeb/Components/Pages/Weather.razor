@page "/weather"
@using Goke.Core.Models
@using Goke.Core.Services

@attribute [StreamRendering]

@inject IHttpClientFactory httpClientFactory

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates showing data.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <WeatherForecastList Forecasts="forecasts" />
}

@code {
    private WeatherForecast[]? forecasts;

    List<WeatherForecast> DATA = new List<WeatherForecast>();

    DateTime current = DateTime.UtcNow;


    protected override async Task OnInitializedAsync()
    {
        HttpClient httpClient = httpClientFactory.CreateClient(BackendApiEndpoints.ClientName);

        // Seed weather data here
        DATA = await httpClient.GetFromJsonAsync<List<WeatherForecast>>("api/weather") ?? [];

        await OnLoadDataAsync();
    }

    protected async Task OnLoadDataAsync()
    {

        current = DateTime.UtcNow;

        // Simulate asynchronous loading to demonstrate a loading indicator
        await Task.Delay(500);

        forecasts = [.. DATA.Where(f => DateTime.Now.AddDays(-1) < f.Date && f.Date <= DateTime.Now.AddDays(1))];

    }
}
