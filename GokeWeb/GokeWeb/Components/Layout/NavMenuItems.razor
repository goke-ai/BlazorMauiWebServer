@using Goke.Blazor.Components

<li class="nav-item">
    <NavLink class="nav-link" href="counter">
        <BsIcon Name="@Icons.PlusSquareFill" />
        Counter
    </NavLink>
</li>

<li class="nav-item">
    <NavLink class="nav-link" href="weather">
        <BsIcon Name="@Icons.CloudsFill" />
        Weather
    </NavLink>
</li>

<MapMenuItems />

<li class="nav-item">
    <NavLink class="nav-link" href="chat">
        <BsIcon Name="@Icons.ChatSquareText" />
        Chat
    </NavLink>
</li>


<li class="nav-item">
    <NavLink class="nav-link" href="auth">
        <BsIcon Name="@Icons.LockFill" />
        Auth Required
    </NavLink>
</li>

<AuthorizeView>
    <Authorized>
        <AccountAuthorizedMenuItems UserName="@context.User.Identity?.Name" CurrentUrl="@currentUrl" />
    </Authorized>
    <NotAuthorized>
        <AccountNotAuthorizedMenuItems />
    </NotAuthorized>
</AuthorizeView>                
        
@code {
    private string? currentUrl;

   
    // theme
    private string CurrentTheme { get; set; } = "dark";
    private bool IsDarkTheme { get; set; }

    private Task OnCurrentThemeChanged(string theme)
    {
        CurrentTheme = theme;
        IsDarkTheme = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
        return Task.CompletedTask;
    }

    private Task OnIsDarkThemeChanged(bool value)
    {
        IsDarkTheme = value;
        CurrentTheme = value ? "dark" : "light";
        return Task.CompletedTask;
    }
}