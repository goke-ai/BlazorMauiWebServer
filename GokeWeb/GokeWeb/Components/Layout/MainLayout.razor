@using Goke.Blazor.Components.Layout
@using GokeWeb.Components.Shared

@inherits LayoutComponentBase

<BaseLayout>
    <BrandContent>
        GokeWeb
    </BrandContent>

    <AdditionalMenuItems>
        <NavMenuItems />
    </AdditionalMenuItems>

    <NavMenuEndItems>
        <ThemeNavMenu CurrentTheme="@CurrentTheme"
                      CurrentThemeChanged="@OnCurrentThemeChanged"
                      IsDarkTheme="@IsDarkTheme"
                      IsDarkThemeChanged="@OnIsDarkThemeChanged" />
    </NavMenuEndItems>

    <Body>
        @Body
    </Body>
</BaseLayout>

                                          
@code {
    // theme
    private string CurrentTheme { get; set; } = "dark";
    private bool IsDarkTheme { get; set; }

    private Task OnCurrentThemeChanged(string theme)
    {
        CurrentTheme = theme;
        IsDarkTheme = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
        return Task.CompletedTask;
    }

    private Task OnIsDarkThemeChanged(bool value)
    {
        IsDarkTheme = value;
        CurrentTheme = value ? "dark" : "light";
        return Task.CompletedTask;
    }
}

    