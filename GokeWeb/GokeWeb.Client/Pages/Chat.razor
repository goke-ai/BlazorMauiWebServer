@page "/chat"
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Goke.Core.Authentication
@using Goke.Core.Chat
@using Goke.Core.Services
@using GokeShared.Components
@using GokeWeb.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client

@attribute [Authorize]
@rendermode InteractiveAuto

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BackendApiEndpoints BackendApiEndpoints
@inject IAccessTokenProvider AccessTokenProvider
@inject ICookieProvider CookieProvider
@inject IHttpClientFactory HttpClientFactory
@implements IAsyncDisposable

<PageTitle>Chat</PageTitle>
<h3>Welcome, @senderName!</h3>

<ChatArea Users="FilteredUsers"
          Messages="messages"
          IsConnected="IsConnected"
          OnSendMessage="Send"
          OnSelectedUser="SelectUser" />


@code {
    List<User> users = new List<User>();
    private User? _selectedUser;
    private List<MessageDto> messages = new List<MessageDto>();
    private Dictionary<string, bool> Users = new Dictionary<string, bool>();

    string? senderName;
    string? currentUserId;

    public List<User> FilteredUsers => users.Where(w => w.UserId != currentUserId).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        senderName = user.Identity?.Name;

        users = await GetUsersAsync();

        var currentUser = users.FirstOrDefault(u => u.FullName == senderName);
        currentUserId = currentUser?.UserId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser())
        {
            return;
        }

        await InitializeRealtimeAsync();
    }

    private async Task<List<User>> GetUsersAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient(BackendApiEndpoints.ClientName);
            var accessToken = await AccessTokenProvider.GetAccessTokenAsync();

            using var request = new HttpRequestMessage(HttpMethod.Get, "api/chat/users");

            if (!string.IsNullOrWhiteSpace(accessToken))
            {
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);
            }

            using var response = await httpClient.SendAsync(request);
            response.EnsureSuccessStatusCode();

            return await response.Content.ReadFromJsonAsync<List<User>>() ?? [];
        }
        catch
        {
            return [];
        }
    }

    private void SelectUser(User user)
    {
        _selectedUser = user;
    }

    private HubConnection? hubConnection;
    Uri? hubUri;
    Func<Task<string?>>? accessTokenProvider = null;
    Func<HttpMessageHandler>? httpMessageHandlerFactory = null;
    CookieContainer? cookies = null;
    public event EventHandler<RealtimeConnectionStateChangedEventArgs>? ConnectionStateChanged;


    void RegisterHubConnectionMethodHandlers()
    {
        if (hubConnection is null)
        {
            throw new InvalidOperationException("Hub connection is not initialized.");
        }

        hubConnection.On<string>("UserConnected",
        userId =>
        {
            Users[userId] = true;
            users.FirstOrDefault(u => u.UserId == userId)!.IsOnline = true;

            messages.Add(new MessageDto
            {
                SenderId = userId,
                ReceiverId = null,
                Content = $"User {userId} connected.",
                Type = MessageType.Text,
                CreatedAt = DateTime.UtcNow
            });
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<string>("UserDisconnected",
            userId =>
            {
                Users[userId] = false;
                users.FirstOrDefault(u => u.UserId == userId)!.IsOnline = false;
                messages.Add(new MessageDto
                {
                    SenderId = userId,
                    ReceiverId = null,
                    Content = $"User {userId} disconnected.",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });

        hubConnection.On<MessageDto>("ReceivePrivateMessage",
            message =>
            {
                messages.Add(message);
                InvokeAsync(StateHasChanged);
            });

        hubConnection.On<MessageDto>("MessageSent",
            message =>
            {
                messages.Add(message);
                InvokeAsync(StateHasChanged);
            });

        hubConnection.On<MessageDto>("ReceiveGroupMessage",
            message =>
            {
                messages.Add(message);
                InvokeAsync(StateHasChanged);
            });

        // startTyping and stopTyping events
        hubConnection.On<string>("StartTyping",
            userId =>
            {
                // Handle start typing event
                messages.Add(new MessageDto
                {
                    SenderId = userId,
                    ReceiverId = null,
                    Content = $"User {userId} is typing...",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });

        hubConnection.On<string>("StopTyping",
            userId =>
            {
                // Handle stop typing event
                messages.Add(new MessageDto
                {
                    SenderId = userId,
                    ReceiverId = null,
                    Content = $"User {userId} stopped typing.",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });

        // message read, delivered, and seen events
        hubConnection.On<string>("MessageRead",
            messageId =>
            {
                // Handle message read event
                messages.Add(new MessageDto
                {
                    Id = Guid.Parse(messageId),
                    SenderId = currentUserId,
                    ReceiverId = null,
                    Content = $"Message {messageId} has been read.",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });

        hubConnection.On<string>("MessageDelivered",
            messageId =>
            {
                // Handle message delivered event
                messages.Add(new MessageDto
                {
                    Id = Guid.Parse(messageId),
                    SenderId = currentUserId,
                    ReceiverId = null,
                    Content = $"Message {messageId} has been delivered.",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });

        hubConnection.On<string>("MessageSeen",
            messageId =>
            {
                // Handle message seen event
                messages.Add(new MessageDto
                {
                    Id = Guid.Parse(messageId),
                    SenderId = currentUserId,
                    ReceiverId = null,
                    Content = $"Message {messageId} has been seen.",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });


        // group join, leave, and remove events
        hubConnection.On<string>("GroupJoined",
            groupId =>
            {
                // Handle group joined event
                messages.Add(new MessageDto
                {
                    SenderId = currentUserId,
                    ReceiverId = null,
                    Content = $"You have joined group {groupId}.",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });

        hubConnection.On<string>("GroupLeft",
            groupId =>
            {
                // Handle group left event
                messages.Add(new MessageDto
                {
                    SenderId = currentUserId,
                    ReceiverId = null,
                    Content = $"You have left group {groupId}.",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });

        hubConnection.On<string>("GroupRemoved",
            groupId =>
            {
                // Handle group removed event
                messages.Add(new MessageDto
                {
                    SenderId = currentUserId,
                    ReceiverId = null,
                    Content = $"Group {groupId} has been removed.",
                    Type = MessageType.Text,
                    CreatedAt = DateTime.UtcNow
                });
                InvokeAsync(StateHasChanged);
            });

    }

    private async Task Send(SendMessageRequest request)
    {
        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("SendPrivateMessage", request);
        }
    }

    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    protected async Task InitializeRealtimeAsync()
    {
        hubUri = CreateHubUri("hubs/chat");
        accessTokenProvider = GetAccessTokenAsync;
        //cookies = await CreateAuthCookies();

        await EnsureConnectedAsync();
    }

    public async Task EnsureConnectedAsync(CancellationToken cancellationToken = default)
    {
        if (hubConnection is not null)
        {
            if (hubConnection.State == HubConnectionState.Disconnected)
            {
                OnConnectionStateChanged(HubConnectionState.Connecting, "Connecting to location sharing...");
                await hubConnection.StartAsync(cancellationToken);
                OnConnectionStateChanged(hubConnection.State, "Connected to location sharing.");
            }

            return;
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUri!, options =>
            {
                if (accessTokenProvider is not null)
                {
                    options.AccessTokenProvider = accessTokenProvider;
                }

                if (httpMessageHandlerFactory is not null)
                {
                    options.HttpMessageHandlerFactory = _ => httpMessageHandlerFactory();
                }

                if (cookies is not null)
                {
                    options.Cookies = cookies;
                }
            })
            .WithAutomaticReconnect()
            .Build();

        RegisterHubConnectionMethodHandlers();


        hubConnection.Reconnecting += _ =>
        {
            OnConnectionStateChanged(HubConnectionState.Reconnecting, "Reconnecting to chat hub...");
            return Task.CompletedTask;
        };

        hubConnection.Reconnected += _ =>
        {
            OnConnectionStateChanged(hubConnection.State, "Connected to chat hub...");
            return Task.CompletedTask;
        };

        hubConnection.Closed += _ =>
        {
            OnConnectionStateChanged(HubConnectionState.Disconnected, "Disconnected from chat hub.");
            return Task.CompletedTask;
        };

        OnConnectionStateChanged(HubConnectionState.Connecting, "Connecting to chat hub...");
        await hubConnection.StartAsync(cancellationToken);
        OnConnectionStateChanged(hubConnection.State, "Connected to chat hub.");
    }

    public async Task ShareMessageAsync(SendMessageRequest request, CancellationToken cancellationToken = default)
    {
        await EnsureConnectedAsync(cancellationToken);
        if (hubConnection is not null)
        {
            await hubConnection.InvokeAsync("ShareMessage", request, cancellationToken);
        }
    }

    private Uri CreateHubUri(string relativePath)
    {
        var hubBaseUri = BackendApiEndpoints.BaseUri;
        return new Uri(hubBaseUri, relativePath);
    }

    private Task<string?> GetAccessTokenAsync()
        => AccessTokenProvider.GetAccessTokenAsync();

    private Task<CookieContainer?> CreateAuthCookies()
    {
        return CookieProvider.CreateAuthCookies();
    }


    private void OnConnectionStateChanged(HubConnectionState state, string message)
    {
        ConnectionStateChanged?.Invoke(this, new RealtimeConnectionStateChangedEventArgs(state, message));
    }


    public sealed record RealtimeConnectionStateChangedEventArgs(HubConnectionState State, string Message);
}