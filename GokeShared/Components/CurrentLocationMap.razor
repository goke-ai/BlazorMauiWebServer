@using Goke.Core.Models
@using Goke.Core.Map
@implements IAsyncDisposable

@if (!_showMapHost)
{
    <p><em>@EmptyMessage</em></p>
}
else
{
    <div class="position-relative">
        <div id="map" style="height: 520px;" class="rounded border"></div>
        <div id="empty-state"
             class="position-absolute top-0 start-0 w-100 h-100 rounded border bg-body-tertiary text-body-secondary fst-italic align-items-center justify-content-center"
             style="display: none;">
            @EmptyMessage
        </div>
    </div>
}

@code {
    [Parameter]
    public IEnumerable<MapMarker> Markers { get; set; } = [];

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private const string MapScriptFileName = "./current-location-map.js";
    private const string __MAP_CONFIG_NAME__ = "currentLocationMapConfig";
    private const string __MAP_BRIDGE_NAME__ = "currentLocationMapBridge";

    private const string EmptyMessage = "Current location is unavailable.";
    private const string TileWarningMessage = "Map tiles are unavailable right now. Current location markers are still shown.";

    private MapMarker[] _markers = [];
    private IJSObjectReference? _mapModule;
    private bool _showMapHost;
    private bool _isMapInitialized;

    protected override void OnParametersSet()
    {
        _markers = (Markers ?? []).ToArray();
        _showMapHost = _showMapHost || _markers.Length > 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_showMapHost)
        {
            return;
        }

        await InitializeOrUpdateMapAsync();
    }

    private async Task InitializeOrUpdateMapAsync()
    {
        _mapModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/GokeShared/js/map-view.js");

        var markers = _markers;

        if (!_isMapInitialized)
        {
            await _mapModule.InvokeVoidAsync(
                "renderMap",
                MapScriptFileName,
                __MAP_CONFIG_NAME__,
                __MAP_BRIDGE_NAME__,
                markers,
                EmptyMessage,
                TileWarningMessage);

            _isMapInitialized = true;
            return;
        }

        if (_markers.Length == 0)
        {
            await _mapModule.InvokeVoidAsync(
                "clear",
                __MAP_CONFIG_NAME__,
                __MAP_BRIDGE_NAME__);

            return;
        }

        await _mapModule.InvokeVoidAsync(
            "setMap",
            __MAP_CONFIG_NAME__,
            __MAP_BRIDGE_NAME__,
            markers,
            BuildMapOptions(fitBounds: true));
    }

    private static object BuildMapOptions(bool fitBounds = false)
    {
        return new
        {
            emptyMessage = EmptyMessage,
            tileWarningMessage = TileWarningMessage,
            fitBounds
        };
    }

    
    public async ValueTask DisposeAsync()
    {
        if (_mapModule is null)
        {
            return;
        }

        try
        {
            await _mapModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}