@using Goke.Core.Models

@if (Forecasts is null || !Forecasts.Any())
{
    <p><em>No forecast data available.</em></p>
}
else
{
    <div class="row g-3">
        @foreach (var forecast in Forecasts)
        {
            <div class="col-12 col-xl-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@forecast.City</strong>
                            <div class="text-body-secondary small">
                                @forecast.Date.ToString("yyyy-MM-dd htt")
                            </div>
                        </div>
                        <div class="fs-4" title="@forecast.Summary">@forecast.SummaryIcon</div>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="d-flex flex-wrap gap-3 align-items-end">
                                    <div>
                                        <div class="text-body-secondary small">Temperature</div>
                                        <div class="fs-3 fw-semibold">
                                            @forecast.TemperatureC°C
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-body-secondary small">Feels like</div>
                                        <div class="fs-5">@forecast.FeelsLikeTemperatureC°C</div>
                                    </div>
                                    <div>
                                        <div class="text-body-secondary small">Range</div>
                                        <div>@forecast.MinimumTemperatureC°C - @forecast.MaximumTemperatureC°C</div>
                                    </div>
                                    <div>
                                        <div class="text-body-secondary small">Summary</div>
                                        <div>@forecast.Summary</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h6 class="border-bottom pb-1 mb-2">Location</h6>
                                <dl class="row mb-0">
                                    <dt class="col-5">Latitude</dt>
                                    <dd class="col-7">@forecast.Latitude.ToString("0.####")</dd>

                                    <dt class="col-5">Longitude</dt>
                                    <dd class="col-7">@forecast.Longitude.ToString("0.####")</dd>

                                    <dt class="col-5">Daylight</dt>
                                    <dd class="col-7">@forecast.DaylightHours.ToString("0.0") hrs</dd>
                                </dl>
                            </div>

                            <div class="col-md-6">
                                <h6 class="border-bottom pb-1 mb-2">Rain & Air</h6>
                                <dl class="row mb-0">
                                    <dt class="col-7">Rain chance</dt>
                                    <dd class="col-5">@forecast.RainProbabilityPercent%</dd>

                                    <dt class="col-7">Humidity</dt>
                                    <dd class="col-5">@forecast.HumidityPercent%</dd>

                                    <dt class="col-7">Dew point</dt>
                                    <dd class="col-5">@forecast.DewPointC.ToString("0.0")°C</dd>

                                    <dt class="col-7">Pressure</dt>
                                    <dd class="col-5">@forecast.PressureHpa hPa</dd>

                                    <dt class="col-7">Visibility</dt>
                                    <dd class="col-5">@forecast.VisibilityKm.ToString("0.0") km</dd>

                                    <dt class="col-7">AQI</dt>
                                    <dd class="col-5">@forecast.AirQualityIndex (@GetAqiLabel(forecast.AirQualityIndex))</dd>

                                    <dt class="col-7">UV</dt>
                                    <dd class="col-5">@forecast.UVIndex (@GetUvLabel(forecast.UVIndex))</dd>
                                </dl>
                            </div>

                            <div class="col-md-6">
                                <h6 class="border-bottom pb-1 mb-2">Wind</h6>
                                <dl class="row mb-0">
                                    <dt class="col-7">Speed</dt>
                                    <dd class="col-5">@forecast.WindSpeedKph.ToString("0.0") kph</dd>

                                    <dt class="col-7">Gust</dt>
                                    <dd class="col-5">@forecast.WindGustKph.ToString("0.0") kph</dd>

                                    <dt class="col-7">Direction</dt>
                                    <dd class="col-5">@forecast.WindDirection (@forecast.WindDirectionDegrees°)</dd>
                                </dl>
                            </div>

                            <div class="col-md-6">
                                <h6 class="border-bottom pb-1 mb-2">Recommendation</h6>
                                <p class="mb-0">@forecast.ActivityRecommendation</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public IEnumerable<WeatherForecast> Forecasts { get; set; } = [];

    private static string GetAqiLabel(int aqi) =>
        aqi switch
        {
            <= 50 => "Good",
            <= 100 => "Moderate",
            <= 150 => "Unhealthy for sensitive groups",
            <= 200 => "Unhealthy",
            <= 300 => "Very unhealthy",
            _ => "Hazardous"
        };

    private static string GetUvLabel(int uvIndex) =>
        uvIndex switch
        {
            <= 2 => "Low",
            <= 5 => "Moderate",
            <= 7 => "High",
            <= 10 => "Very high",
            _ => "Extreme"
        };
}