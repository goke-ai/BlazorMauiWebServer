@using Goke.Core.Map
@using Goke.Core.Models
@using GokeSharedCore.MapApp
@using GokeSharedCore.WeatherApp

<style>
    .swipe-tabs {
        display: flex;
        overflow-x: auto;
        overflow-y: hidden;
        gap: 0.5rem;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
    }

        .swipe-tabs::-webkit-scrollbar {
            display: none; /* hide scrollbar on mobile */
        }

    .swipe-tab {
        flex: 0 0 auto;
        scroll-snap-align: start;
    }
</style>

@if (Forecasts is null || !Forecasts.Any())
{
    <p><em>No forecast data available.</em></p>
}
else
{
    @foreach (var cityGroup in Forecasts.OrderBy(f => f.City)
                                .GroupBy(f => f.City))
    {
        <section class="mb-4">
            <h3 class="mb-3">@cityGroup.Key</h3>

            @{
                // group by date first
                var dateGroups = cityGroup
                                .GroupBy(f => f.Date.Date)
                                .OrderBy(g => g.Key)
                                .ToList();

                if (!dateGroups.Any())
                {
                    continue;
                }

                //var selectedDate = GetSelectedDate(cityGroup.Key);
                var availableDates = dateGroups.Select(g => g.Key).ToList();
                var selectedDate = GetSelectedDate(cityGroup.Key, availableDates);
            }

            <!-- DATE TABS -->            
            <ul class="nav nav-tabs" role="tablist">
                @foreach (var dateGroup in dateGroups)
                {
                    <li class="nav-item">
                        <button type="button"
                        class="nav-link @(dateGroup.Key == selectedDate ? "active" : null)"
                        @onclick="() => SelectDate(cityGroup.Key, dateGroup.Key)">
                            @dateGroup.Key.ToString("yyyy-MM-dd")
                        </button>
                    </li>
                }
            </ul>

            @{
                var dayGroup = dateGroups.FirstOrDefault(g => g.Key == selectedDate);
            }

            @if (dayGroup is null)
            {
                <p><em>No forecast data available for @cityGroup.Key.</em></p>
            }
            else
            {
                var orderedHours = dayGroup.OrderBy(f => f.Date).ToList();
                // Get the selected forecast for this group
                var selectedForecast = GetSelectedForecast(cityGroup.Key, orderedHours);
                var selectedTime = GetValidSelectedTime(cityGroup.Key, orderedHours);

                <!-- HOUR TABS -->
                <div class="mb-4">
                    <h5 class="text-body-secondary mb-3">@dayGroup.Key.ToString("yyyy-MM-dd")</h5>

                    <ul class="nav nav-pills" role="tablist">
                        @foreach (var forecast in orderedHours)
                        {
                            <li class="nav-item">
                                <button type="button"
                                class="nav-link @(forecast.Date.TimeOfDay == selectedTime ? "active" : null)"
                                @onclick="() => SelectTime(cityGroup.Key, forecast.Date.TimeOfDay)">
                                    @forecast.Date.ToString("HH:mm")
                                </button>
                            </li>
                        }
                    </ul>

                    <!-- FORECAST CARD -->
                    @if(selectedForecast is not null)
                    {
                        <WeatherForecastCard SelectedForecast="selectedForecast" />
                        <CurrentLocationMap Markers="_markers" />
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No forecast available for @cityGroup.Key on @dayGroup.Key.ToString("yyyy-MM-dd").
                        </div>
                    }
                </div>
            }            
        </section>
    }
}

@code {
    [Parameter]
    public IEnumerable<WeatherForecast> Forecasts { get; set; } = [];

    public List<MapMarker> _markers = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var forecast = Forecasts.FirstOrDefault();

        var location = new Goke.Core.Map.Location
        {
            Latitude = forecast?.Latitude ?? 0,
            Longitude = forecast?.Longitude ?? 0,
            Name = forecast?.City ?? "Unknown"
        };

        _markers = new[] { location }.Select(location => new MapMarker
        {
            Latitude = location.Latitude,
            Longitude = location.Longitude,
            Name = location.Name,
            Description = $"Lat: {location.Latitude}, Lon: {location.Longitude}",
            MarkerShape = "Circle",
            MarkerColor = MapMarker.GetColor(location.Name),
        }).ToList();

        StateHasChanged();
    }


    protected override void OnParametersSet()
    {
        InitializeDefaults();
    }

    private readonly Dictionary<string, DateTime> _selectedDates = [];
    private readonly Dictionary<string, TimeSpan> _selectedTimes = [];

    protected void InitializeDefaults()
    {
        var validCities = new HashSet<string>();

        var now = DateTime.Now;

        foreach (var cityGroup in Forecasts.GroupBy(f => f.City))
        {
            var city = cityGroup.Key;

            validCities.Add(city);

            var availableDates = cityGroup
                .Select(f => f.Date.Date)
                .Distinct()
                .OrderBy(d => d)
                .ToList();

            if (availableDates.Count == 0)
            {
                continue;
            }

            //
            // DATE
            //
            if (!_selectedDates.TryGetValue(city, out var selectedDate))
            {
                selectedDate = availableDates.Contains(now.Date)
                    ? now.Date
                    : availableDates.First();
            }

            if (!availableDates.Contains(selectedDate.Date))
            {
                selectedDate = availableDates
                    .OrderBy(d => Math.Abs((d - selectedDate.Date).TotalDays))
                    .First();
            }

            _selectedDates[city] = selectedDate.Date;

            //
            // TIME
            //
            var availableTimes = cityGroup
                .Select(f => f.Date.TimeOfDay)
                .Distinct()
                .OrderBy(t => t)
                .ToList();

            if (availableTimes.Count == 0)
            {
                continue;
            }

            if (!_selectedTimes.TryGetValue(city, out var selectedTime))
            {
                selectedTime = availableTimes
                    .OrderBy(t => CircularDistance(t, now.TimeOfDay))
                    .First();
            }

            if (!availableTimes.Contains(selectedTime))
            {
                selectedTime = availableTimes
                    .OrderBy(t => CircularDistance(t, selectedTime))
                    .First();
            }

            _selectedTimes[city] = selectedTime;
        }

        //
        // Remove stale cities
        //
        foreach (var city in _selectedDates.Keys.Except(validCities).ToList())
        {
            _selectedDates.Remove(city);
        }

        foreach (var city in _selectedTimes.Keys.Except(validCities).ToList())
        {
            _selectedTimes.Remove(city);
        }
    }
    private void SelectDate(string city, DateTime date)
    {
        _selectedDates[city] = date.Date;
    }

    private void SelectTime(string city, TimeSpan time)
    {
        _selectedTimes[city] = time;
    }

    private DateTime GetSelectedDate(string city, IReadOnlyCollection<DateTime> availableDates)
    {
        if (availableDates.Count == 0)
        {
            return DateTime.MinValue;
        }

        if (_selectedDates.TryGetValue(city, out var selectedDate) &&
            availableDates.Contains(selectedDate.Date))
        {
            return selectedDate.Date;
        }

        var fallback = availableDates.Min();

        _selectedDates[city] = fallback;

        return fallback;
    }

    private TimeSpan GetSelectedTime(string city)
    {
        return _selectedTimes[city];
    }

    private WeatherForecast? GetSelectedForecast(
    string city,
    IReadOnlyList<WeatherForecast> forecasts)
    {
        if (forecasts.Count == 0)
        {
            return null;
        }

        var selectedTime = GetValidSelectedTime(city, forecasts);

        return forecasts
            .OrderBy(f =>
                CircularDistance(
                    f.Date.TimeOfDay,
                    selectedTime))
            .FirstOrDefault();
    }

    private TimeSpan GetValidSelectedTime(string city, IReadOnlyList<WeatherForecast> forecasts)
    {
        if (forecasts.Count == 0)
        {
            return TimeSpan.Zero;
        }

        var availableTimes = forecasts
            .Select(f => f.Date.TimeOfDay)
            .Distinct()
            .OrderBy(t => t)
            .ToList();

        if (!_selectedTimes.TryGetValue(city, out var selectedTime))
        {
            selectedTime = availableTimes.First();
        }

        if (availableTimes.Contains(selectedTime))
        {
            return selectedTime;
        }

        selectedTime = availableTimes
            .OrderBy(t => CircularDistance(t, selectedTime))
            .First();

        _selectedTimes[city] = selectedTime;

        return selectedTime;
    }

    private static TimeSpan CircularDistance(TimeSpan a, TimeSpan b)
    {
        var diff = (a - b).Duration();

        return diff > TimeSpan.FromHours(12)
            ? TimeSpan.FromHours(24) - diff
            : diff;
    }

}