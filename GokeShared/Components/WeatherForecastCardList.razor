@using Goke.Core.Map
@using Goke.Core.Models

<style>
    .swipe-tabs {
        display: flex;
        overflow-x: auto;
        overflow-y: hidden;
        gap: 0.5rem;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
    }

        .swipe-tabs::-webkit-scrollbar {
            display: none; /* hide scrollbar on mobile */
        }

    .swipe-tab {
        flex: 0 0 auto;
        scroll-snap-align: start;
    }
</style>

@if (Forecasts is null || !Forecasts.Any())
{
    <p><em>No forecast data available.</em></p>
}
else
{
    @foreach (var cityGroup in Forecasts
        .OrderBy(f => f.City)
        .GroupBy(f => f.City))
    {
        <section class="mb-4">
            <h3 class="mb-3">@cityGroup.Key</h3>

            @{
                //group by date first
                var dateGroups = cityGroup
                .GroupBy(f => f.Date.Date)
                .OrderBy(g => g.Key).ToList();

                // Select the default date for this city group
                var selectedDate = dateGroups.FirstOrDefault(f => f.Key == DateTime.UtcNow.Date)?.Key ?? dateGroups.First().Key;

                // Select the first date as default
                var dateKey = GetGroupKey(cityGroup.Key, "DATE");
                if (_selectedForecasts.TryGetValue(dateKey, out var storedDate))
                {
                    if (dateGroups.Any(g => g.Key == storedDate))
                    {
                        selectedDate = storedDate;
                    }
                }
            }

            <!-- DATE TABS -->
            <ul class="nav nav-tabs" role="tablist">
                @foreach (var dateGroup in dateGroups)
                {
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(dateGroup.Key == selectedDate ? "active" : null)"
                                @onclick="() => SelectForecast(dateKey, dateGroup.Key)">
                            @dateGroup.Key.ToString("yyyy-MM-dd")
                        </button>
                    </li>
                }
            </ul>

            <!-- HOUR TABS -->
            @* @foreach (var dayGroup in cityGroup
                .OrderBy(f => f.Date)
                .GroupBy(f => f.Date.Date)) *@
            @{
                var dayGroup = dateGroups.First(g => g.Key == selectedDate);
                var orderedHours = dayGroup.OrderBy(f => f.Date).ToList();
                var groupKey = GetGroupKey(cityGroup.Key, dayGroup.Key);
                var selectedForecast = GetSelectedForecast(groupKey, orderedHours);

                <div class="mb-4">
                    <h5 class="text-body-secondary mb-3">@dayGroup.Key.ToString("yyyy-MM-dd")</h5>

                    <ul class="nav nav-pills" role="tablist">
                        @foreach (var forecast in orderedHours)
                        {
                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link @(selectedForecast.Date == forecast.Date ? "active" : null)"
                                        @onclick="() => SelectForecast(groupKey, forecast.Date)">
                                    @forecast.Date.ToString("HH")
                                </button>
                            </li>
                        }
                    </ul>

                    <!-- FORECAST CARD -->
                    <WeatherForecastCard SelectedForecast="selectedForecast" />

                    <CurrentLocationMap Markers="_markers" />

                </div>
            }
        </section>
    }
}

@code {
    [Parameter]
    public IEnumerable<WeatherForecast> Forecasts { get; set; } = [];

    private readonly Dictionary<string, DateTime> _selectedForecasts = [];

    public List<MapMarker> _markers = [];

    protected override void OnParametersSet()
    {
        var validKeys = new HashSet<string>();

        foreach (var dayGroup in Forecasts.GroupBy(f => new { f.City, Day = f.Date.Date }))
        {
            var groupKey = GetGroupKey(dayGroup.Key.City, dayGroup.Key.Day);
            var orderedForecasts = dayGroup.OrderBy(f => f.Date).ToList();
            var defaultForecast = orderedForecasts.FirstOrDefault();

            validKeys.Add(groupKey);

            if (defaultForecast is null)
            {
                continue;
            }

            if (!_selectedForecasts.TryGetValue(groupKey, out var selectedDate) ||
                orderedForecasts.All(f => f.Date != selectedDate))
            {
                _selectedForecasts[groupKey] = defaultForecast.Date;
            }
        }

        foreach (var staleKey in _selectedForecasts.Keys.Except(validKeys).ToList())
        {
            _selectedForecasts.Remove(staleKey);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var forecast = Forecasts.FirstOrDefault();
        var location = new Goke.Core.Map.Location
        {
            Latitude = forecast?.Latitude ?? 0,
            Longitude = forecast?.Longitude ?? 0,
            Name = forecast?.City ?? "Unknown"
        };

        _markers = new[] { location }.Select(location => new MapMarker
        {
            Latitude = location.Latitude,
            Longitude = location.Longitude,
            Name = location.Name,
            Description = $"Lat: {location.Latitude}, Lon: {location.Longitude}",
            MarkerShape = "Circle",
            MarkerColor = MapMarker.GetColor(location.Name),
        }).ToList();

        StateHasChanged();
    }

    private static string GetGroupKey(string city, string key)
        => $"{city}|{key}";

    private static string GetGroupKey(string city, DateTime day)
        => $"{city}|{day:yyyyMMdd}";

    private WeatherForecast GetSelectedForecast(string groupKey, IReadOnlyList<WeatherForecast> forecasts)
    {
        if (forecasts.Count == 0)
        {
            throw new InvalidOperationException("Forecast group cannot be empty.");
        }

        if (_selectedForecasts.TryGetValue(groupKey, out var selectedDate))
        {
            var selectedForecast = forecasts.FirstOrDefault(f => f.Date.Date == selectedDate && f.Date.Hour == DateTime.UtcNow.Hour);
            if (selectedForecast is not null)
            {
                return selectedForecast;
            }
        }

        return forecasts[0];
    }

    private void SelectForecast(string groupKey, DateTime forecastDate)
        => _selectedForecasts[groupKey] = forecastDate;


}