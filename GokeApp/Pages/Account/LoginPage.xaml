<?xml version="1.0" encoding="utf-8" ?>
<controls:ScrollViewPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GokeApp.Pages.Controls"
             x:Class="GokeApp.Pages.Account.LoginPage"
             x:Name="LoginPageName"
             Title="Login">
    
    <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
        <Label
            Text="Log in"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Label
            Text="Use a local account to log in, then enable fingerprint, face, or PIN for quick sign-in."
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2" />

        <BoxView
            HeightRequest="1"
            Opacity="0.2" />

        <Label
            x:Name="MessageLabel"
            BackgroundColor="#FDE7E9"
            Padding="12,8"
            TextColor="#8A1F17"
            IsVisible="{Binding IsMessageVisible}"
            Text="{Binding Message}" />

        <Label Text="Email" />
        <Entry
            x:Name="EmailEntry"
            Keyboard="Email"
            Placeholder="name@example.com"
            ClearButtonVisibility="WhileEditing"
            Text="{Binding Email}" />

        <Label Text="Password" />
        <Entry
            x:Name="PasswordEntry"
            IsPassword="True"
            Text="{Binding Password}"
            Placeholder="password"
            ClearButtonVisibility="WhileEditing" />

        <HorizontalStackLayout Spacing="10">
        <CheckBox x:Name="RememberMeCheckBox"
                        IsChecked="{Binding RememberMe}" />
        <Label
                VerticalOptions="Center"
                Text="Remember me" />
        </HorizontalStackLayout>

        <Button
            x:Name="LoginButton"
            Text="Log in"
            Command="{Binding LoginCommand}"
            HorizontalOptions="Fill" />

        <Button
            Text="Register"
            Command="{Binding RegisterCommand}"
            HorizontalOptions="Fill" />

    </VerticalStackLayout>

</controls:ScrollViewPage>