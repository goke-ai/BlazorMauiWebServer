<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:weatherApp="clr-namespace:GokeSharedCore.WeatherApp;assembly=GokeSharedCore"
             xmlns:controls="clr-namespace:GokeApp.Pages.Controls"
             x:Name="this"
             x:Class="GokeApp.Pages.Controls.WeatherForecastListView"
             x:DataType="controls:WeatherForecastListView">


    <VerticalStackLayout>
        <Grid ColumnDefinitions="*,*,*,*,*"
              ColumnSpacing="12">
            <Label Grid.Column="0" FontAttributes="Bold" Text="City" />
            <Label Grid.Column="1" FontAttributes="Bold" Text="Date" />
            <Label Grid.Column="2" FontAttributes="Bold" Text="Temp. (C)" />
            <Label Grid.Column="3" FontAttributes="Bold" Text="Temp. (F)" />
            <Label Grid.Column="4" FontAttributes="Bold" Text="Summary" />
        </Grid>

        <CollectionView ItemsSource="{Binding Source={x:Reference this}, Path=Forecasts}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="weatherApp:WeatherForecast">
                    <Grid Padding="0,8"
                  ColumnDefinitions="*,*,*,*,*"
                  ColumnSpacing="12">
                        <Label Grid.Column="0" Text="{Binding City}" />
                        <Label Grid.Column="1" Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd htt}'}" />
                        <Label Grid.Column="2" Text="{Binding TemperatureC}" />
                        <Label Grid.Column="3" Text="{Binding TemperatureF}" />
                        <HorizontalStackLayout Grid.Column="4"
                                       Spacing="6"
                                       SemanticProperties.Description="{Binding Summary}">
                            <Label Text="{Binding SummaryIcon}"
                           FontSize="16"
                           VerticalOptions="Center"
                           SemanticProperties.Description="{Binding Summary}" />
                            <Label Text="{Binding Summary}"
                           VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
