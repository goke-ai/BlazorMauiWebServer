<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps" 
             xmlns:controls="clr-namespace:GokeApp.Pages.Controls"
             x:Class="GokeApp.Pages.Controls.WeatherForecastMapView"
             x:Name="this">

    <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">

        <Label FontSize="12"
               Opacity="0.7"
               Text="{Binding VisibleCity, Source={x:Reference this}}" />
        
        <Label x:Name="EmptyStateLabel"
               Text="No forecast data available."
               IsVisible="False" />

        <Label x:Name="NoMatchesLabel"
               Text="No cities match the selected temperature filters."
               IsVisible="False" />

        <Border x:Name="NativeMapContainer"
                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                HeightRequest="520">
            <maps:Map x:Name="WeatherMap" IsShowingUser="False" MapType="Street" />
        </Border>
        
        <Border x:Name="WebMapContainer"
                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                HeightRequest="520">

            <WebView x:Name="WeatherMapWebView" />

        </Border>
    </VerticalStackLayout>
</ContentView>