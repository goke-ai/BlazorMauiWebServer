@page "/weather-city"
@using Goke.Blazor.Components.Extensions

@inject NavigationManager NavigationManager

<PageTitle>@City |Weather</PageTitle>

<GokeShared.Components.Pages.WeatherCity City="@City" />            


@code {
    [Parameter]
    public string? City { get; set; }


    protected override async Task OnParametersSetAsync()
    {
        base.OnParametersSet();

        City ??= NavigationManager.QueryString["city"];
    }
}