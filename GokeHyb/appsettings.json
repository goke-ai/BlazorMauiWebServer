{
  "BackendApi": {
    "BaseUrl": "https://localhost:7000",
    "LoginPath": "identity/login",
    "RegisterPath": "identity/register",
    "LogoutPath": "identity/logout",
    "RefreshPath": "identity/refresh",
    "MePath": "identity/me",
    "WeatherPath": "api/weather"
  },
  "Hubs": {
    "BaseUrl": "https://localhost:7000",
    "Connections": [
      {
        "HubName": "chat",
        "Path": "/hubs/chat",
        "AuthProvider": "AccessToken"
      },
      {
        "HubName": "notifications",
        "Path": "/hubs/notifications",
        "AuthProvider": "AccessToken"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
